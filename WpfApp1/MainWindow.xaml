<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow"  Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FFB291FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Viewbox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="325"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Button x:FieldModifier="public" x:Name="dugme_Registrovanje" Grid.Row="0" Width="150" Height="40px" VerticalAlignment="Bottom" BorderThickness="2" BorderBrush="#FFF39535" Background="#FF383569" Foreground="#FFF39535" FontFamily="Bahnschrift Light Condensed" FontSize="20" Click="klik_Registrovanje">REGISTRUJ SE</Button>
                <Button x:FieldModifier="public" x:Name="dugme_Prijavljivanje" Grid.Row="2" Width="150" Height="40px" VerticalAlignment="Top" BorderThickness="2" BorderBrush="#FFF39535" Background="#FF383569" Foreground="#FFF39535" FontSize="20" FontFamily="Bahnschrift Light Condensed" Click="klik_PrijavljivanjeProzor">PRIJAVI SE</Button>
            </Grid>
        </Grid>
    </Viewbox>

</Window>
