<Window x:Class="WpfApp1.Prozori.Radnici_Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Prozori"
        mc:Ignorable="d"
        Title="Radnici_Admin" Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#FF1A1A1A">
    <Viewbox>
        <Grid Width="800" Height="440">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button  x:FieldModifier="public" Name="dugme_Nazad"                          Width="100" Height="20" Grid.Row="0" Content="Nazad"           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_Nazad"/>

                <Label   x:FieldModifier="public" Name="labela_ImeRadnikaAdmin"               Width="100" Height="25" Grid.Row="1" Content="Ime radnika"     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_ImeRadnikaAdmin"              Width="100" Height="20" Grid.Row="1"                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_PrezimeRadnikaAdmin"           Width="100" Height="25" Grid.Row="2" Content="Prezime radnika"   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_PrezimeRadnikaAdmin"          Width="100" Height="20" Grid.Row="2"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_RadnaPozicijaRadnikaAdmin"     Width="100" Height="25" Grid.Row="3" Content="Radna pozicija"    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_RadnaPozicijaRadnikaAdmin"    Width="100" Height="20" Grid.Row="3"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_JMBGRadnikaAdmin"              Width="100" Height="25" Grid.Row="4" Content="JMBG"              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_JMBGRadnikaAdmin"             Width="100" Height="20" Grid.Row="4"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_PTTRadnikaAdmin"               Width="100" Height="25" Grid.Row="5" Content="PTT"               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_PTTRadnikaAdmin"              Width="100" Height="20" Grid.Row="5"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_AdresaStanovanjaRadnikaAdmin"  Width="110" Height="25" Grid.Row="1" Content="Adresa stanovanja" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="350,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_AdresaStanovanjaRadnikaAdmin" Width="100" Height="20" Grid.Row="1"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="250,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_KontaktTelefonRadnikaAdmin"    Width="100" Height="25" Grid.Row="2" Content="Kontakt telefon"   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="350,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_KontaktTelefonRadnikaAdmin"   Width="100" Height="20" Grid.Row="2"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="250,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_PlataRadnikaAdmin"             Width="100" Height="25" Grid.Row="3" Content="Plata"             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="350,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_PlataRadnikaAdmin"            Width="100" Height="20" Grid.Row="3"                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="250,0,0,0"/>

                <Label   x:FieldModifier="public" Name="labela_IdRadnikaAdmin"      Width="100" Height="25" Grid.Row="4" Content="ID Radnika" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="350,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_IdRadnikaAdmin"     Width="100" Height="20" Grid.Row="4"                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="250,0,0,0" IsReadOnly="True"/>

                <Label   x:FieldModifier="public" Name="labela_IdOsobeAdmin"        Width="100" Height="25" Grid.Row="5" Content="ID Osobe"   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="350,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox x:FieldModifier="public" Name="textbox_IdOsobeRadnikAdmin" Width="100" Height="20" Grid.Row="5"                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="250,0,0,0" IsReadOnly="True"/>

                <Button  x:FieldModifier="public" Name="dugme_UnesiRadnikaAdmin"       Width="80" Height="20" Grid.Row="0" Content="Unesi"         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_UnesiRadnika"/>
                <Button  x:FieldModifier="public" Name="dugme_IzmeniRadnikaAdmin"      Width="80" Height="20" Grid.Row="1" Content="Izmeni"        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_IzmeniRadnika"/>
                <Button  x:FieldModifier="public" Name="dugme_IzbrisiRadnikaAdmin"     Width="80" Height="20" Grid.Row="2" Content="Izbrisi"       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_IzbrisiRadnika"/>
                <Button  x:FieldModifier="public" Name="dugme_OsveziPoljaRadnikAdmin"  Width="80" Height="20" Grid.Row="3" Content="Osvezi polja"  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_OsveziPolja"/>
                <Button  x:FieldModifier="public" Name="dugme_OsveziTabeluRadnikAdmin" Width="80" Height="20" Grid.Row="5" Content="Osvezi tabelu" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_OsveziTabelu"/>
            </Grid>
            <DataGrid x:FieldModifier="public" Name="datagrid_Radnici" Grid.Row="1" Width="770" Height="215" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" AutoGenerateColumns="False" SelectionChanged="radnici_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding idRadnika}"        Header="ID"                Width="30"/>
                    <DataGridTextColumn Binding="{Binding ime}"              Header="Ime"               Width="100"/>
                    <DataGridTextColumn Binding="{Binding prezime}"          Header="Prezime"           Width="100"/>
                    <DataGridTextColumn Binding="{Binding radnaPozicija}"    Header="Radna pozicija"    Width="*"/>
                    <DataGridTextColumn Binding="{Binding JMBG}"             Header="JMBG"              Width="95"/>
                    <DataGridTextColumn Binding="{Binding PTT}"              Header="PTT"               Width="50"/>
                    <DataGridTextColumn Binding="{Binding adresaStanovanja}" Header="Adresa Stanovanja" Width="*"/>
                    <DataGridTextColumn Binding="{Binding kontaktTelefon}"   Header="Kontakt telefon"   Width="91"/>
                    <DataGridTextColumn Binding="{Binding plata}"            Header="Plata"             Width="55"/>
                    <DataGridTextColumn Binding="{Binding idOsobe}"          Header="ID Osobe"          Width="*" Visibility="Hidden"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Viewbox>
</Window>
