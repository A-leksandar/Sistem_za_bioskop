<Window x:Class="WpfApp1.Prozori.Filmovi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Prozori"
        mc:Ignorable="d"
        Title="Filmovi" Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FFB291FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Viewbox>
        <Grid Width="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="390"/>
            </Grid.RowDefinitions>
            <Button x:FieldModifier="public" x:Name="dugmeNazad" Width="20" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,10,0,0" Foreground="#00000000" Background="#00DDDDDD" BorderBrush="Transparent" Click="klik_Nazad">
                <Polygon Points="19,-5 19,35 0,17" Height="31">
                    <Polygon.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="White"/>
                            <GradientStop Color="#FFAE9BD8" Offset="1"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
            </Button>
            <Button x:Name="dugme_Karte" Width="90" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Content="Karte" FontSize="17" BorderThickness="2" BorderBrush="#FFF39535" Background="#FF383569" Foreground="#FFF39535" FontFamily="Bahnschrift Light Condensed" Click="klik_Karte"/>
            <Label Content="FILMOVI" Width="400" Height="70" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,10,0,0" FontFamily="Arial Black" FontSize="36" Grid.RowSpan="2">
                <Label.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="#FFAE9BD8" Offset="1"/>
                    </LinearGradientBrush>
                </Label.Foreground>
            </Label>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Width="770" Grid.Row="1">
                <Grid x:Name="grid_Filmovi">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Viewbox>
</Window>
