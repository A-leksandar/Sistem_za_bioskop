<Window x:Class="WpfApp1.Prozori.Rezervacija"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Prozori"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Rezervacija" Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FFB291FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Viewbox>
        <Grid Name="grid_RezervisiGlavni" Width="770" Height="430">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="grid_Rezervisi0" Grid.Column="0" Width="280" Height="280" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30,0,0,50" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <ComboBox Name="combobox_VrstaKartica" Grid.Row="1" Width="100" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                    <ComboBoxItem>Visa</ComboBoxItem>
                    <ComboBoxItem>MasterCard</ComboBoxItem>
                </ComboBox>
                <Label    Name="labela_BrojKartice"                     Grid.Row="2"  Width="100" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="6,5,0,0"  FontSize="10" Content="Broj kartice"   />
                <TextBox  Name="textbox_BrojKarticeKorisnika"           Grid.Row="3"  Width="150" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="10,0,0,0" FontSize="10"                          />
                <Label    Name="labela_BezbednosniKod"                  Grid.Row="2"  Width="100" Height="23" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,0"  FontSize="10" Content="Bezbednosni kod"/>
                <TextBox  Name="textbox_BezbednosniKodKarticeKorisnika" Grid.Row="3"  Width="50"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Right"  Margin="0,0,65,0" FontSize="10"                          />
                <Label    Name="labela_ImeKorisnika"                    Grid.Row="4"  Width="100" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="6,5,0,0"  FontSize="10" Content="Ime"            />
                <Label    Name="labela_PrezimeKorisnika"                Grid.Row="4"  Width="100" Height="23" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,69,0" FontSize="10" Content="Prezime"        />
                <TextBox  Name="textbox_ImeKorisnika"                   Grid.Row="5"  Width="100" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="10,0,0,0" FontSize="10"                          />
