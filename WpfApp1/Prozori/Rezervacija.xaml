                <Label    Name="labela_EmailKorisnika"                  Grid.Row="6"  Width="100" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="6,5,0,0"  FontSize="10" Content="Email"          />
                <TextBox  Name="textbox_EmailKorisnika"                 Grid.Row="7"  Width="150" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="10,0,0,0" FontSize="10"                          />
                <Label    Name="labela_DatumProjekcijeREADONLY"         Grid.Row="8"  Width="100" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="6,5,0,0"  FontSize="10" Content="Datum projekcije"  />
