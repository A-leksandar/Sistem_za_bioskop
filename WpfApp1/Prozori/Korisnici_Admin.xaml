<Window x:Class="WpfApp1.Prozori.Korisnici_Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Prozori"
        mc:Ignorable="d"
        Title="Korisnici_Admin" Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#FF1A1A1A">
    <Viewbox>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button   x:FieldModifier="public" Name="dugme_Nazad"                         Width="100" Height="20"  Grid.Row="0" HorizontalAlignment="Left"   VerticalAlignment="Center" Margin="15,0,0,0" Content="Nazad"         Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_Nazad"/>
            <Button   x:FieldModifier="public" Name="dugme_OsveziTabeluKorisnikAdmin"     Width="80"  Height="20"  Grid.Row="0" HorizontalAlignment="Right"  VerticalAlignment="Center" Margin="0,0,15,0" Content="Osvezi tabelu" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_OsveziTabelu"/>
            <DataGrid x:FieldModifier="public" Name="datagrid_Korisnici"                  Width="770" Height="385" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"    Margin="15,5,15,5" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding idKorisnika}" Header="ID Korisnika" Width="*"/>
                    <DataGridTextColumn Binding="{Binding email}"       Header="Email"        Width="*"/>
                    <DataGridTextColumn Binding="{Binding lozinka}"     Header="Lozinka"      Width="*"/>
                    <DataGridTextColumn Binding="{Binding ime}"         Header="Ime"          Width="*"/>
                    <DataGridTextColumn Binding="{Binding prezime}"     Header="Prezime"      Width="*"/>
                    <DataGridTextColumn Binding="{Binding idOsobe}"     Header="ID Osobe"     Width="*" Visibility="Hidden"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Viewbox>
</Window>
