<Window x:Class="WpfApp1.Prozori.Karte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Prozori"
        mc:Ignorable="d"
        Title="Karte" Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FFB291FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Viewbox>
        <Grid Width="770" Height="430">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:FieldModifier="public" x:Name="dugmeNazad" Width="20" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,10,0,0" Foreground="#00000000" Background="#00DDDDDD" BorderBrush="Transparent" Click="klik_Nazad">
                <Polygon Points="19,-5 19,35 0,17" Height="31">
                    <Polygon.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="White"/>
                            <GradientStop Color="#FFAE9BD8" Offset="1"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
            </Button>
            <Label Content="KARTE" Width="150" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,10,0,0" FontFamily="Arial Black" FontSize="36" Grid.RowSpan="2">
                <Label.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="#FFAE9BD8" Offset="1"/>
                    </LinearGradientBrush>
                </Label.Foreground>
            </Label>
            <TextBox  x:Name="textbox_IdKarteKorisnik" Grid.Row="0" Width="100" Height="25"  VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,105,0" IsReadOnly="True"/>
            <Button   x:Name="dugme_IzbrisiKartu"      Grid.Row="0" Width="80"  Height="25"  VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0" Content="Izbriši" FontSize="17" BorderThickness="2" BorderBrush="#FFF39535" Background="#FF383569" Foreground="#FFF39535" FontFamily="Bahnschrift Light Condensed" Click="klik_IzbrisiKartu"/>
            <DataGrid x:Name="datagrid_KarteKorisnik"  Grid.Row="1" Width="743" Height="350" VerticalAlignment="Center" HorizontalAlignment="Center" AutoGenerateColumns="False" SelectionChanged="karte_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding idKarte}"         Header="ID"               Width="55"/>
                    <DataGridTextColumn Binding="{Binding nazivFilma}"      Header="Naziv filma"      Width="*"/>
                    <DataGridTextColumn Binding="{Binding datumProjekcije}" Header="Datum projekcije" Width="120"/>
                    <DataGridTextColumn Binding="{Binding cena}"            Header="Cena karte"       Width="80"/>
                    <DataGridTextColumn Binding="{Binding nazivSale}"       Header="Sala"             Width="80"/>
                    <DataGridTextColumn Binding="{Binding idSedista}"       Header="Broj sedišta"     Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Viewbox>
</Window>
