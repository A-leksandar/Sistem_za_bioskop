<Window x:Class="WpfApp1.Prozori.Film"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Prozori"
        mc:Ignorable="d"
        Title="Film" Height="450" Width="800" MinHeight="450" MinWidth="800" WindowState="Maximized">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FFB291FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Viewbox>
        <Grid x:Name="glavni_Grid" Width="782" Height="425">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="415"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="grid_0" Grid.Column="0" Width="385">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:FieldModifier="public" x:Name="dugmeNazad" Width="20" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Foreground="#00000000" Background="#00DDDDDD" BorderBrush="Transparent" Click="klik_Nazad">
                    <Polygon Points="19,-5 19,35 0,17" Height="31">
                        <Polygon.Fill>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="White"/>
                                <GradientStop Color="#FFAE9BD8" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                </Button>
            </Grid>
            <Grid Grid.Column="1" Width="415" Background="#66000000">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="37" MaxHeight="77"/>
                    <RowDefinition MinHeight="30" MaxHeight="30"/>
                    <RowDefinition MinHeight="30" MaxHeight="280"/>
                    <RowDefinition MinHeight="40" MaxHeight="60"/>
                    <RowDefinition MinHeight="30"  Height="*"/>
                </Grid.RowDefinitions>
                <Label    Name="labela_NazivFilma"     Grid.Row="0" MinHeight="35" MaxHeight="75" Width="383"  VerticalAlignment="Top"    HorizontalAlignment="Center" Margin="15,14,15,0" Foreground="White" FontFamily="Bahnschrift Light" FontSize="36" BorderBrush="Transparent"/>
                <Label                                 Grid.Row="1" MinHeight="15" MaxHeight="75" Width="383"  VerticalAlignment="Top"    HorizontalAlignment="Center" Margin="15,5,15,0"  Foreground="White"                                FontSize="10" BorderBrush="Transparent" Content="Opis filma:"/>
                <Label    Name="labela_OpisFilma"      Grid.Row="2" MinHeight="35" MaxHeight="75" Width="383"  VerticalAlignment="Top"    HorizontalAlignment="Center" Margin="15,0,15,0"  Foreground="White"                                FontSize="10" BorderBrush="Transparent"/>
                <Label    Name="labela_CenaFilma"      Grid.Row="3" Height="25"                   Width="AUTO" VerticalAlignment="Center" HorizontalAlignment="Left"   Margin="15,0,0,0"   Foreground="White"                                FontSize="10" BorderBrush="Transparent"/>
                <Button x:Name="dugme_RezervisiFilm"   Grid.Row="3" Height="17"                   Width="55"   VerticalAlignment="Center" HorizontalAlignment="Right"  Margin="0,0,15,0"   Foreground="White"                                FontSize="10" Background="Transparent"  BorderBrush="#7F000000" Content="REZERVIŠI" Click="klik_RezervisiFilm"/>

                <DataGrid Name="datagrid_GlumciIUloge" Grid.Row="4" Width="385" Height="117" VerticalAlignment="Top" HorizontalAlignment="Center" AutoGenerateColumns="False" BorderBrush="#FF8C55C7" RowBackground="#FFD9C9E2" AlternatingRowBackground="#FFCBB2E4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding GLUMAC}"   Header="Glumac"   Width="*"/>
                        <DataGridTextColumn Binding="{Binding uloga}"    Header="Uloga"    Width="*"/>
                        <DataGridTextColumn Binding="{Binding idGlumca}" Header="Uloga"    Width="*" Visibility="Hidden"/>
                    </DataGrid.Columns>
                </DataGrid>
                
            </Grid>
        </Grid>
    </Viewbox>
</Window>
