                    <DataGridTextColumn Binding="{Binding idProjekcije}"    Header="ID Projekcije"    Width="76"/>
                    <DataGridTextColumn Binding="{Binding idFilma}"         Header="ID Filma"         Width="52"/>
                    <DataGridTextColumn Binding="{Binding idSale}"          Header="ID Sale"          Width="46"/>
                    <DataGridTextColumn Binding="{Binding nazivFilma}"      Header="Naziv filma"      Width="105"/>
                    <DataGridTextColumn Binding="{Binding datumProjekcije}" Header="Datum projek." Width="*"/>
