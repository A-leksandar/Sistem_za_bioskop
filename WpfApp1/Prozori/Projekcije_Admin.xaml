                    <RowDefinition Height="35"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <Button     x:FieldModifier="public"    Name="dugme_Nazad"                     Width="100" Height="20" Grid.Row="0" Content="Nazad"    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Background="#FF2E2E2E" Foreground="#FFB2B2B2" BorderBrush="#FF4D4D4D" Click="klik_Nazad"/>

                <Label      x:FieldModifier="public"    Name="labela_IdSaleAdmin"              Width="100" Height="25" Grid.Row="3" Content="ID Sale"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <ComboBox   x:FieldModifier="public"    Name="combobox_IdSaleAdmin"            Width="100" Height="20" Grid.Row="3"                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                    <ComboBoxItem>SALA 1</ComboBoxItem>
                    <ComboBoxItem>SALA 2</ComboBoxItem>
                    <ComboBoxItem>SALA 3</ComboBoxItem>
                    <ComboBoxItem>SALA 4</ComboBoxItem>
                    <ComboBoxItem>SALA 5</ComboBoxItem>
                    <ComboBoxItem>SALA 6</ComboBoxItem>
                </ComboBox>

                <Label      x:FieldModifier="public"    Name="labela_IdProjekcijeAdmin"        Width="100" Height="25" Grid.Row="1" Content="ID Projekcije" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox    x:FieldModifier="public"    Name="textbox_IdProjekcijeAdmin"       Width="100" Height="20" Grid.Row="1"                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" IsReadOnly="True"/>

                <Label      x:FieldModifier="public"    Name="labela_IdFilmaAdmin"             Width="100" Height="25" Grid.Row="2" Content="ID Filma"      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox    x:FieldModifier="public"    Name="textbox_IdFilmaAdmin"            Width="100" Height="20" Grid.Row="2"                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" IsReadOnly="True"/>

                <Label      x:FieldModifier="public"    Name="labela_NazivFilmaAdmin"          Width="100" Height="25" Grid.Row="4" Content="Naziv filma"   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,2" Foreground="#FFB2B2B2"/>
                <TextBox    x:FieldModifier="public"    Name="textbox_NazivFilmaAdmin"         Width="100" Height="20" Grid.Row="4"                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" IsReadOnly="True"/>

